<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".GlanceOverviewWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_glance_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_glance_info" />
        </receiver>

        <receiver
            android:name=".SafetyWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_safety_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_safety_info" />
        </receiver>

        <receiver
            android:name=".DaylightWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_daylight_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_daylight_info" />
        </receiver>

        <!-- Redraws the widgets when the clock, the time zone or the language changes, so "Updated 12:40" and the sunset time follow the traveller. -->
        <receiver
            android:name=".WidgetEnvironmentChangedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".tile.NomadStatusTileService"
            android:exported="true"
            android:icon="@drawable/ic_widget_tile_dashboard"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
